@model List<IncidenciasApp.Models.Incidencia>

@{
    ViewData["Title"] = "Incidencias abiertas encontradas";
}

<h1>Incidencias abiertas con consulta rápida</h1>

<form method="get" asp-action="Index" class="mb-3 d-flex" style="max-width:400px; gap:8px;">
    <input type="text" name="q" value="@ViewData["Query"]" class="form-control" placeholder="Buscar por estacion o descripcion..." />
    <button type="submit" class="btn btn-primary">Buscar</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Estación</th>
            <th>Descripción</th>
            <th>Prioridad</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var incidencia in Model)
        {
            <tr>
                <td>@incidencia.Estacion</td>
                <td>@incidencia.Descripcion</td>
                <td>@incidencia.Prioridad</td>
                <td>@incidencia.Estado</td>
                <td>
                    <form asp-action="Cerrar" asp-route-id="@incidencia.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">Cerrar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p>No hay incidencias abiertas.</p>
}
