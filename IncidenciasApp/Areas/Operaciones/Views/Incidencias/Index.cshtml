@model List<IncidenciasApp.Models.Incidencia>

@{
    ViewData["Title"] = "Incidencias abiertas en tiempo real";
}

<h1>Incidencias abiertas en tiempo real</h1>

<form method="get" asp-action="Index" class="mb-3 d-flex" style="max-width:400px; gap:8px;">
    <input type="text" name="q" value="@ViewData["Query"]" class="form-control" placeholder="Buscar por estación o descripción..." />
    <button type="submit" class="btn btn-primary">Buscar</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Estación</th>
            <th>Descripción</th>
            <th>Prioridad</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="tabla-incidencias">
        @foreach (var incidencia in Model)
        {
            <tr id="fila-@incidencia.Id">
                <td>@incidencia.Estacion</td>
                <td>@incidencia.Descripcion</td>
                <td>@incidencia.Prioridad</td>
                <td class="estado">@incidencia.Estado</td>
                <td>
                    <form asp-action="Cerrar" asp-route-id="@incidencia.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">Cerrar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p>No hay incidencias abiertas.</p>
}

@section Scripts {
    <script>
        const pieSocketApiKey = "@ViewData["PieSocketApiKey"]";
        const pieSocketCluster = "@ViewData["PieSocketCluster"]";
        const wsUrl = `wss://${pieSocketCluster}.piesocket.com/v3/incidencias?api_key=${pieSocketApiKey}&notify_self=1`;

        function conectarWebSocket() {
            const ws = new WebSocket(wsUrl);

            ws.onmessage = function (event) {
                try {
                    const data = JSON.parse(event.data);
                    if (data.evento === "IncidenciaActualizada" && data.estado === "Cerrada") {
                        const fila = document.getElementById("fila-" + data.id);
                        if (fila) fila.remove();
                    }
                } catch (e) {
                    console.error("Mensaje no valido de PieSocket", e);
                }
            };

            ws.onclose = function () {
                console.log("WebSocket cerrado, reconectando y consultando estado vigente...");
                setTimeout(function () {
                    window.location.reload();
                }, 2000);
            };

            ws.onerror = function (err) {
                console.error("Error WebSocket PieSocket", err);
            };
        }

        conectarWebSocket();
    </script>
}